# Copia este archivo como .env para configurar Atias en este equipo. .env no se sube al repositorio.
WEB_PORT=3000
API_PORT=4000

# Obligatorio cambiarla fuera del entorno local, por una contraseña larga y aleatoria.
POSTGRES_PASSWORD=atias_local

# 1 activa los enlaces de prueba públicos (/subir/demo-invernadero-1, -2 y -3). Solo en local:
# fuera de este equipo, quita la línea. Sin ellos, la API los retira de la base de datos.
ATIAS_DATOS_DEMO=1

# Usa 1 en cuanto haya HTTPS: la cookie de sesión solo viajará cifrada.
ATIAS_COOKIE_SEGURA=0

# 1 solo si delante de la web hay un proxy que sustituye X-Forwarded-For por la dirección real.
# "cloudflare" si se entra por un túnel de Cloudflare (lo fija compose.tunel.yaml).
ATIAS_PROXY_DE_CONFIANZA=0

# Token del túnel con nombre de Cloudflare, para publicar con HTTPS (compose.tunel.yaml).
# Es una contraseña: quien lo tenga puede hacerse pasar por este túnel. Ver docs/DOCKER.md.
# Al usar el túnel se fijan solos ATIAS_DATOS_DEMO=0, ATIAS_COOKIE_SEGURA=1 y
# ATIAS_PROXY_DE_CONFIANZA=cloudflare, digan lo que digan las líneas de arriba.
CLOUDFLARE_TUNNEL_TOKEN=

# GB que deben quedar siempre libres en el disco de los vídeos.
ATIAS_ESPACIO_LIBRE_GB=10

# Núcleos de CPU para el análisis. Contar frutos es lento: súbelo si el equipo tiene más libres.
ATIAS_CPUS_ANALISIS=2
