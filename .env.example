# Copia este archivo como .env si necesitas cambiar los puertos. No guardes aquí secretos en el repositorio.
WEB_PORT=3000
API_PORT=4000
# Obligatorio cambiarla fuera del entorno local.
POSTGRES_PASSWORD=atias_local
# 1 crea enlaces de prueba públicamente conocidos. Usa 0 fuera del entorno local.
ATIAS_DATOS_DEMO=1
# Usa 1 en cuanto haya HTTPS: la cookie de sesión solo viajará cifrada.
ATIAS_COOKIE_SEGURA=0
